# Example environment file for /etc/gocloak-auth-proxy/proxy.env (chmod 0600)
ISSUER=https://keycloak.example.com/realms/myrealm
AUDIENCE=my-api
LISTEN_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9090
SHUTDOWN_DRAIN_DELAY=5s
LOG_LEVEL=info
ACCESS_LOG=false
# CLIENT_SECRET_FILE=/run/credentials/gocloak-auth-proxy.service/client-secret
# OIDC_COOKIE_SECRET_FILE=/run/credentials/gocloak-auth-proxy.service/cookie-secret
