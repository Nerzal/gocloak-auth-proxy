{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Nerzal/gocloak-auth-proxy/main/config.schema.json",
  "title": "gocloak-auth-proxy Configuration",
  "description": "Strict JSON configuration schema for gocloak-auth-proxy (CONFIG_FILE). Environment variables override file values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "JSON Schema URI for IDE autocompletion." },
    "issuer": { "type": "string", "format": "uri", "description": "Primary Keycloak realm issuer URL (e.g. https://keycloak.example.com/realms/myrealm)." },
    "allowed_issuers": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Explicit allowlist of Keycloak realm issuer URLs for multi-realm/multi-tenant verification." },
    "audience": { "type": "string", "description": "Expected JWT aud claim." },
    "upstream_url": { "type": "string", "format": "uri", "description": "Fixed reverse-proxy upstream URL. Omit for forward-auth mode on /auth." },
    "listen_addr": { "type": "string", "default": ":8080", "description": "Proxy listen address (host:port)." },
    "metrics_addr": { "type": "string", "description": "Dedicated internal listen address for Prometheus /metrics (e.g. :9090)." },
    "log_level": { "type": "string", "enum": ["debug", "info", "warn", "error"], "default": "info" },
    "access_log": { "type": "boolean", "default": false, "description": "Emit structured JSON access logs (method, path, status, duration_ms, trace_id; never logs secrets/emails)." },
    "trusted_proxies": { "type": "array", "items": { "type": "string" }, "description": "CIDR/IP allowlist permitted to supply X-Forwarded-For/Proto/Host headers." },
    "client_id": { "type": "string", "description": "Keycloak client ID." },
    "client_secret": { "type": "string", "description": "Keycloak client secret." },
    "client_secret_file": { "type": "string", "description": "Path to file containing Keycloak client secret (e.g. Kubernetes/Docker secret mount)." },
    "header_user": { "type": "string", "default": "X-Auth-Request-User" },
    "header_email": { "type": "string", "default": "X-Auth-Request-Email" },
    "header_groups": { "type": "string", "default": "X-Auth-Request-Groups" },
    "header_roles": { "type": "string", "default": "X-Auth-Request-Roles" },
    "custom_claim_headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Map of Header-Name to JWT claim name." },
    "pass_access_token": { "type": "boolean", "default": false },
    "allowed_algorithms": { "type": "array", "items": { "type": "string", "enum": ["RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "ES512", "EdDSA"] }, "default": ["RS256", "ES256"] },
    "required_realm_roles": { "type": "array", "items": { "type": "string" } },
    "required_client_roles": { "type": "array", "items": { "type": "string" } },
    "role_match_mode": { "type": "string", "enum": ["all", "any"], "default": "all" },
    "required_groups": { "type": "array", "items": { "type": "string" } },
    "group_match_mode": { "type": "string", "enum": ["all", "any"], "default": "all" },
    "required_scopes": { "type": "array", "items": { "type": "string" } },
    "required_acr": { "type": "array", "items": { "type": "string" } },
    "required_amr": { "type": "array", "items": { "type": "string" } },
    "require_email_verified": { "type": "boolean", "default": false },
    "required_azp": { "type": "string" },
    "required_organization": { "type": "string" },
    "jwks_refresh_interval": { "type": "string", "default": "5m" },
    "clock_skew": { "type": "string", "default": "30s" },
    "token_cache_size": { "type": "integer", "minimum": 0, "maximum": 100000, "default": 4096 },
    "shutdown_drain_delay": { "type": "string", "default": "0s", "description": "Delay after marking /readyz=503 before stopping HTTP server on SIGTERM (0s-5m)." },
    "keycloak_ca_file": { "type": "string" },
    "keycloak_client_cert_file": { "type": "string" },
    "keycloak_client_key_file": { "type": "string" },
    "upstream_ca_file": { "type": "string" },
    "upstream_client_cert_file": { "type": "string" },
    "upstream_client_key_file": { "type": "string" },
    "tls_cert_file": { "type": "string" },
    "tls_key_file": { "type": "string" },
    "server_read_header_timeout": { "type": "string", "default": "5s" },
    "server_read_timeout": { "type": "string", "default": "15s" },
    "server_write_timeout": { "type": "string", "default": "30s" },
    "server_idle_timeout": { "type": "string", "default": "60s" },
    "upstream_header_timeout": { "type": "string", "default": "15s" },
    "upstream_request_timeout": { "type": "string", "default": "25s" },
    "introspection_enabled": { "type": "boolean", "default": false },
    "introspection_cache_ttl": { "type": "string", "default": "15s" },
    "uma_enabled": { "type": "boolean", "default": false },
    "uma_method_scope": { "type": "boolean", "default": false },
    "public_paths": { "type": "array", "items": { "type": "string" } },
    "optional_auth_paths": { "type": "array", "items": { "type": "string" } },
    "allow_cors_preflight": { "type": "boolean", "default": false },
    "route_rules": { "type": "array", "items": { "type": "string" } },
    "oidc_enabled": { "type": "boolean", "default": false },
    "oidc_redirect_url": { "type": "string", "format": "uri" },
    "oidc_post_logout_url": { "type": "string", "default": "/" },
    "oidc_cookie_secret": { "type": "string", "minLength": 32 },
    "oidc_cookie_secret_file": { "type": "string" },
    "oidc_cookie_secret_previous": { "type": "string", "minLength": 32, "description": "Previous cookie encryption secret for zero-downtime key rotation." },
    "oidc_cookie_secret_previous_file": { "type": "string" },
    "oidc_cookie_name": { "type": "string", "default": "__Host-gocloak_session" },
    "oidc_cookie_domain": { "type": "string" },
    "oidc_cookie_secure": { "type": "boolean", "default": true },
    "oidc_cookie_samesite": { "type": "string", "enum": ["lax", "strict", "none"], "default": "lax" },
    "oidc_scopes": { "type": "array", "items": { "type": "string" }, "default": ["openid", "profile", "email"] },
    "oidc_session_max_age": { "type": "string", "default": "24h" },
    "oidc_redirect": { "type": "boolean", "default": true },
    "oidc_allowed_redirect_domains": { "type": "array", "items": { "type": "string" } },
    "redis_addr": { "type": "string", "description": "Optional Redis/Valkey host:port for multi-replica OIDC backchannel-logout sync." },
    "redis_password": { "type": "string" },
    "redis_password_file": { "type": "string" },
    "redis_tls": { "type": "boolean", "default": false },
    "redis_ca_file": { "type": "string" }
  }
}
